#, no-wrap
msgid "Criterios"
msgstr ""

#. type: Bullet: '- '
#: ../src/internals/020-package-release.md
msgid "No hay issues críticos."
msgstr ""

#. type: Bullet: '- '
#: ../src/internals/020-package-release.md
msgid "Los cambios en Public API no son probables. Ha pasado algún tiempo sin issues reportados que puedan requerir cambios en API."
msgstr ""

#. type: Bullet: '- '
#: ../src/internals/020-package-release.md
msgid "Todas las dependencias son estables."
msgstr ""

#. type: Bullet: '- '
#: ../src/internals/020-package-release.md
msgid "Cerca de 100% de cobertura de test con, idealmente, una puntuación MSI de 100%."
msgstr ""

#. type: Bullet: '- '
#: ../src/internals/020-package-release.md
msgid "README está bien."
msgstr ""

#. type: Bullet: '- '
#: ../src/internals/020-package-release.md
msgid "Todo está type-hinted excepto casos especiales."
msgstr ""

#. type: Bullet: '- '
#: ../src/internals/020-package-release.md
msgid "Psalm analysis pasa en al menos nivel 2."
msgstr ""

#. type: Bullet: '- '
#: ../src/internals/020-package-release.md
msgid "phpdoc está bien."
msgstr ""

#. type: Bullet: '- '
#: ../src/internals/020-package-release.md
msgid "Public API está bien."
msgstr ""

#. type: Title ##
#: ../src/internals/020-package-release.md
#, no-wrap
msgid "Política de rama de release"
msgstr ""

#. type: Plain text
#: ../src/internals/020-package-release.md
msgid "Usa `master` para todos los releases regulares."
msgstr ""

#. type: Plain text
#: ../src/internals/020-package-release.md
msgid "Crea una rama separada solo cuando releases una nueva versión para una versión major anterior. En este caso, crea la rama desde el último tag en esa línea de la versión major anterior y aplica solo los cambios necesarios para el release."
msgstr ""

#. type: Title ##
#: ../src/internals/020-package-release.md
#, no-wrap
msgid "Instrucciones de release"
msgstr ""

#. type: Plain text
#: ../src/internals/020-package-release.md
msgid "Libera un paquete vía [Yii Development Tool](005-development-tool.md)."
msgstr ""

#. type: Plain text
#: ../src/internals/020-package-release.md
#, no-wrap
msgid ""
"1. Verifica que puedas sign commits localmente (see \n"
"[Signing commits](https://docs.github.com/en/authentication/managing-commit-signature-verification/signing-commits)).\n"
msgstr ""

#. type: Bullet: '2. '
#: ../src/internals/020-package-release.md
msgid "Para releases regulares, extrae últimos cambios desde la rama `master`:"
msgstr ""

#. type: Fenced code block (shell)
#: ../src/internals/020-package-release.md
#, no-wrap
msgid ""
"./yii-dev git/checkout master package-name\n"
"./yii-dev git/pull package-name\n"
msgstr ""

#. type: Plain text
#: ../src/internals/020-package-release.md
msgid "Para releases de previous major version, usa la rama creada de acuerdo a la release branch policy en vez de `master`."
msgstr ""

#. type: Bullet: '3. '
#: ../src/internals/020-package-release.md
msgid "Verifica el paquete para cumplir con los criterios arriba."
msgstr ""

#. type: Bullet: '4. '
#: ../src/internals/020-package-release.md
msgid "Ejecuta comando `release/make`:"
msgstr ""

#. type: Fenced code block (shell)
#: ../src/internals/020-package-release.md
#, no-wrap
msgid "./yii-dev release/make package-name\n"
msgstr ""

#. type: Bullet: '5. '
#: ../src/internals/020-package-release.md
msgid "Selecciona el tipo de versión (major, minor o patch)."
msgstr ""

#. type: Bullet: '6. '
#: ../src/internals/020-package-release.md
msgid "En la pregunta \"Push commits and tags, and release on GitHub?\" verifica un diff. Si el diff está bien, responde \"yes.\""
msgstr ""

#. type: Bullet: '7. '
#: ../src/internals/020-package-release.md
msgid "Para major y minor releases, añade un registro con release notes en [Yii Framework News](https://www.yiiframework.com/news)."
msgstr ""
