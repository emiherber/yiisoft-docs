#. type: Title ####
#: ../src/internals/010-code-style.md
#, no-wrap
msgid "Banderas en métodos"
msgstr ""

#. type: Plain text
#: ../src/internals/010-code-style.md
msgid "Las banderas booleanas en métodos son mejor evitarlas. Es una señal que el método puede estar haciendo demasiado, y debería haber dos métodos en vez de uno."
msgstr ""

#. type: Fenced code block (php)
#: ../src/internals/010-code-style.md
#, no-wrap
msgid "public function login(bool $refreshPage = true): void;\n"
msgstr ""

#. type: Plain text
#: ../src/internals/010-code-style.md
msgid "Es mejor tener dos métodos:"
msgstr ""

#. type: Fenced code block (php)
#: ../src/internals/010-code-style.md
#, no-wrap
msgid ""
"public function login(): void;\n"
"public function refreshPage(): void;\n"
msgstr ""

