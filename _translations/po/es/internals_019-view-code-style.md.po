#. type: Title #
#: ../src/internals/019-view-code-style.md
#, no-wrap
msgid "019 — Estilo de código para plantillas"
msgstr ""

#. type: Plain text
#: ../src/internals/019-view-code-style.md
msgid "El código PHP en los archivos de vista no debería ser complicado.  El código debe contener la lógica responsable de formatear los datos, pero no la lógica para solicitar estos datos."
msgstr ""

#. type: Title ##
#: ../src/internals/019-view-code-style.md
#, no-wrap
msgid "Encabezado"
msgstr ""

#. type: Plain text
#: ../src/internals/019-view-code-style.md
msgid "El encabezado del archivo de vista se usa para colocar phpdoc describiendo variables disponibles y para importar clases:"
msgstr ""

#. type: Fenced code block (php)
#: ../src/internals/019-view-code-style.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"/** @var Post $post */\n"
"/** @var string $name */\n"
"\n"
"use Yiisoft\\Html\\Html;\n"
msgstr ""

#. type: Title ##
#: ../src/internals/019-view-code-style.md
#, no-wrap
msgid "Estructuras de control"
msgstr ""

#. type: Plain text
#: ../src/internals/019-view-code-style.md
msgid "La sintaxis alternativa para estructuras de control como `foreach` y `if` es preferida:"
msgstr ""

#. type: Fenced code block (php)
#: ../src/internals/019-view-code-style.md
#, no-wrap
msgid ""
"<?php foreach ($posts as $post): ?>   \n"
"    <h2><?= Html::encode($post->getTitle()) ?></h2>\n"
"    <p><?= Html::encode($post->getDescription()) ?></p>\n"
"<?php endforeach; ?>\n"
msgstr ""

#. type: Title ##
#: ../src/internals/019-view-code-style.md
#, no-wrap
msgid "El short echo"
msgstr ""

#. type: Plain text
#: ../src/internals/019-view-code-style.md
msgid "El short echo es preferido:"
msgstr ""

#. type: Fenced code block (php)
#: ../src/internals/019-view-code-style.md
#, no-wrap
msgid "<?= Html::encode($name) ?>\n"
msgstr ""

#. type: Title ##
#: ../src/internals/019-view-code-style.md
#, no-wrap
msgid "Métodos de clase"
msgstr ""

#. type: Plain text
#: ../src/internals/019-view-code-style.md
msgid "Todos los métodos de clase usados en archivos de vista deben ser públicos independientemente si la vista es renderizada por la clase misma."
msgstr ""
